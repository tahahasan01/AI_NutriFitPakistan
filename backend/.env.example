# ---- NutriFit backend environment ----
# Copy to .env for local dev (never commit real secrets).

# development | production | testing
NUTRIFIT_ENV=development

# Strong random secret for signing session cookies.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production.
NUTRIFIT_SECRET=

# Database connection string. REQUIRED in production.
# MySQL:   mysql+pymysql://user:password@host:3306/nutrifit
# Postgres: postgresql+psycopg://user:password@host:5432/nutrifit
# Leave blank in dev to auto-use a local SQLite file.
DATABASE_URL=

# Comma-separated allowlist of frontend origins for cross-origin (CORS) calls.
# Leave EMPTY when the Next.js proxy serves the API same-origin (recommended).
# Example (direct cross-origin): https://nutrifit.vercel.app
CORS_ORIGINS=

# Cookie / session
SESSION_COOKIE_NAME=nutrifit_session
SESSION_MAX_AGE=604800

# ---- AI Coach (optional) ----
# Enables the conversational AI coach + natural-language meal logging.
# Set ONE provider key. Priority if several are set: Groq, then OpenAI, then Anthropic.
# Leave all blank to disable the feature (the rest of the app is unaffected).
GROQ_API_KEY=              # https://console.groq.com  (free tier; OpenAI-compatible)
OPENAI_API_KEY=            # https://platform.openai.com
ANTHROPIC_API_KEY=         # https://console.anthropic.com
# Optional model override. Per-provider defaults: groq=openai/gpt-oss-20b,
# openai=gpt-4o-mini, anthropic=claude-sonnet-5.
NUTRIFIT_AI_MODEL=

# Rate-limit storage (memory:// for single instance; redis://... for multi-instance)
RATELIMIT_STORAGE_URI=memory://

# Create tables on startup (dev/first-run). Use Alembic migrations in prod.
AUTO_CREATE_DB=1

LOG_LEVEL=INFO

# ---- Coach web search (optional) ----
# Better quality if set; otherwise a keyless DuckDuckGo fallback is used.
TAVILY_API_KEY=              # https://tavily.com (recommended, free tier)
SERPER_API_KEY=              # https://serper.dev (Google results)
